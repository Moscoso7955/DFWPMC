# Copy to .env.local inside this app. Keep credentials and real environment files out of Git.
# One app serves the hub (fwpublicmarket.com) and all three venues
# (/willow, /madrone, /publicmarketcafe) with one collective staff list.

# Collective admin sign-in. The hub project's historical COLLECTIVE_ADMIN_PASSWORD /
# COLLECTIVE_ADMIN_SESSION_SECRET names are accepted as fallbacks.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=

# Google invite-only sign-in (one redirect URI: <site>/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Per-venue Blackbook passwords/secrets (prefixed per venue app convention).
BLACKBOOK_PASSWORD=
BLACKBOOK_VIEW_PASSWORD=
BLACKBOOK_SESSION_SECRET=

# Hosted CMS: one private Blob store per venue. CMS_<VENUE>_TOKEN falls back
# to CMS_STORAGE_READ_WRITE_TOKEN (the hub project's own store token).
CMS_WILLOW_TOKEN=
CMS_MADRONE_TOKEN=
CMS_PMCAFE_TOKEN=
CMS_STORAGE_READ_WRITE_TOKEN=
CMS_STORAGE_SCOPE=

# Canonical origin, e.g. https://fwpublicmarket.com
NEXT_PUBLIC_SITE_URL=

# One Neon Postgres for the collective (staff list, content rows, mailing lists).
POSTGRES_URL=

# Email (collective Resend account).
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# "false" turns off the local preview guards (production). Anything else
# keeps databases/email/providers disconnected for local work.
NEXT_PUBLIC_LOCAL_PREVIEW=

# Business-wide tracking (one GA4 property / Meta pixel / Ads account for
# the whole collective; events are grouped by venue path). Tracking only
# loads when NEXT_PUBLIC_TRACKING_ENABLED=true.
NEXT_PUBLIC_TRACKING_ENABLED=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=
NEXT_PUBLIC_TRACKING_CONSENT_DEFAULT=

# "true" loads provider embeds (Tipsy booking/application forms) even while
# the local preview keeps payments/database/email disconnected.
NEXT_PUBLIC_EMBEDS_ENABLED=
