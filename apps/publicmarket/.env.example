# Copy to .env.local inside this app. Keep credentials and real environment files out of Git.
# The hub selector/login screens submit to the venue apps; the hub stores no venue credentials.

# Optional loopback targets for the three local login forms (origins must use localhost/127.0.0.1/::1).
LOCAL_ADMIN_MADRONE_ORIGIN=
LOCAL_ADMIN_WILLOW_ORIGIN=
LOCAL_ADMIN_PMCAFE_ORIGIN=

# Optional legacy hub CMS/Blackbook routes only; these credentials do not log into the venues.
# Configure all credentials for any legacy portal you use, including an independent signing secret.
PHOEBE_ADMIN_PASSWORD=
PHOEBE_ADMIN_SESSION_SECRET=
PHOEBE_BLACKBOOK_PASSWORD=
PHOEBE_BLACKBOOK_VIEW_PASSWORD=
PHOEBE_BLACKBOOK_SESSION_SECRET=

# Optional legacy storage/email connection points; leave blank for this handoff.
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
