# Copy to .env.local inside this app. Keep credentials and real environment files out of Git.
# Required for local portal authentication: choose passwords and generate independent signing secrets.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TICKETING_PASSWORD=
TICKETING_DOOR_PASSWORD=
TICKETING_SESSION_SECRET=
BLACKBOOK_PASSWORD=
BLACKBOOK_VIEW_PASSWORD=
BLACKBOOK_SESSION_SECRET=

# Optional hosted CMS: leave token blank to use this app's local content files.
# A hosted CMS preview must use CMS_STORAGE_SCOPE=preview; production configuration stays in Vercel.
# NEXT_PUBLIC_SITE_URL is the canonical URL, including this venue's base path.
CMS_STORAGE_READ_WRITE_TOKEN=
CMS_STORAGE_SCOPE=
NEXT_PUBLIC_SITE_URL=

# Future provider connection points: leave blank. venue.config.json keeps integrations disconnected.
# Populating these fields alone does not authorize enabling the providers.
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
MAILING_LIST_SYNC_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_STATE_SECRET=
QBO_ENVIRONMENT=
QBO_REDIRECT_URI=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
TICKET_EMAIL_FROM=
APPLE_PASS_P12_BASE64=
APPLE_PASS_P12_PASSWORD=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_WWDR_CERT_BASE64=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
CRON_SECRET=
VERCEL_CRON_SECRET=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=
